# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Local dev: run a Postgres and put its URL here, e.g.
#   postgresql://postgres:postgres@localhost:5432/daisy
# Production (Render): use the database's Internal Database URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/daisy"

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# ---- Seed admin account (created on `npm run seed`) ----
ADMIN_EMAIL=admin@daisy.com
ADMIN_PASSWORD=Daisy@Admin123
ADMIN_NAME=Daisy Admin

# ---- Image storage ----
# If Cloudinary vars are set, uploads go to Cloudinary; otherwise they are
# stored on local disk under /uploads and served by the API.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
